# Copy to .env (repo root) for local development. `supabase start` reads these
# for the Edge Functions (see [edge_runtime.secrets] in supabase/config.toml).
FAIRSHIFT_CRON_SECRET=local-dev-cron-secret
FAIRSHIFT_APP_URL=http://localhost:8081
# Optional: real e-mail delivery. Without it, e-mails are logged by the function.
RESEND_API_KEY=
EMAIL_FROM="FairShift <no-reply@example.com>"
