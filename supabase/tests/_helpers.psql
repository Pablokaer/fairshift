-- Test helpers. Included by every test file *inside* its transaction, so
-- everything here is rolled back at the end of the file.
create extension if not exists pgtap with schema extensions;
set search_path = public, extensions;

create schema tests;
create table tests.ids (k text primary key, v uuid not null);

create function tests.id(p_key text) returns uuid language sql stable as $$
  select v from tests.ids where k = p_key;
$$;

create function tests.key(p_id uuid) returns text language sql stable as $$
  select k from tests.ids where v = p_id;
$$;

create function tests.remember(p_key text, p_id uuid) returns uuid language sql as $$
  insert into tests.ids (k, v) values (p_key, p_id)
  on conflict (k) do update set v = excluded.v returning v;
$$;

-- A user created directly in auth.users (like the seed). p_meta may carry
-- hospital_code + profession, which makes the sign-up trigger link them.
create function tests.new_user(p_key text, p_name text default null, p_meta jsonb default '{}') returns uuid
language plpgsql as $$
declare v uuid := gen_random_uuid();
begin
  insert into auth.users (id, instance_id, aud, role, email, encrypted_password, email_confirmed_at,
                          raw_user_meta_data, created_at, updated_at)
  values (v, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated',
          p_key || '@test.local', '', now(),
          jsonb_build_object('display_name', coalesce(p_name, p_key)) || p_meta, now(), now());
  return tests.remember(p_key, v);
end $$;

-- Run p_sql as user p_who (RLS + auth.uid() apply). $1/$2/$3 are bound to a1/a2/a3.
create function tests.act(p_who text, p_sql text, a1 uuid default null, a2 text default null, a3 text default null)
returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims', json_build_object('sub', tests.id(p_who), 'role', 'authenticated')::text, true);
  perform set_config('role', 'authenticated', true);
  execute p_sql using a1, a2, a3;
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '', true);
end $$;

create function tests.val(p_who text, p_sql text, a1 uuid default null, a2 text default null, a3 text default null)
returns text language plpgsql as $$
declare v text;
begin
  perform set_config('request.jwt.claims', json_build_object('sub', tests.id(p_who), 'role', 'authenticated')::text, true);
  perform set_config('role', 'authenticated', true);
  execute p_sql into v using a1, a2, a3;
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '', true);
  return v;
end $$;

-- A hospital (key p_org) with a manager (p_prefix || 'admin'), doctors
-- d1..dN and nurses n1..nN (keys prefixed with p_prefix). Queues: 'qd'/'qn'
-- (prefixed). Nobody is in a queue yet.
create function tests.fixture(p_doctors int, p_nurses int default 0, p_org text default 'org', p_prefix text default '')
returns void language plpgsql as $$
declare
  v_org uuid;
begin
  select org_id into v_org from private.provision_hospital('Hospital ' || p_org, 'America/Sao_Paulo');
  perform tests.remember(p_org, v_org);
  perform tests.remember(p_prefix || 'qd', private.profession_queue(v_org, 'doctor'));
  perform tests.remember(p_prefix || 'qn', private.profession_queue(v_org, 'nurse'));
  perform tests.new_user(p_prefix || 'admin', 'Manager ' || p_org);
  insert into public.memberships (org_id, user_id, role) values (v_org, tests.id(p_prefix || 'admin'), 'owner');
  for i in 1 .. p_doctors loop
    perform tests.new_user(p_prefix || 'd' || i, 'Doctor ' || i);
    insert into public.memberships (org_id, user_id, role, profession)
    values (v_org, tests.id(p_prefix || 'd' || i), 'staff', 'doctor');
  end loop;
  for i in 1 .. p_nurses loop
    perform tests.new_user(p_prefix || 'n' || i, 'Nurse ' || i);
    insert into public.memberships (org_id, user_id, role, profession)
    values (v_org, tests.id(p_prefix || 'n' || i), 'staff', 'nurse');
  end loop;
end $$;

create function tests.join(p_who text, p_queue text default 'qd') returns void language sql as $$
  select tests.act(p_who, 'select public.join_queue($1)', tests.id(p_queue));
$$;

-- Join p_prefix||from .. p_prefix||to in that order.
create function tests.join_range(p_prefix text, p_from int, p_to int, p_queue text default 'qd') returns void
language plpgsql as $$
begin
  for i in p_from .. p_to loop
    perform tests.join(p_prefix || i, p_queue);
  end loop;
end $$;

-- Create (and by default publish) a shift with p_slots slots starting p_offset from now.
create function tests.shift(p_key text, p_offset interval, p_slots int default 1, p_profession text default 'doctor',
                            p_publish boolean default true, p_duration interval default interval '12 hours',
                            p_org text default 'org', p_admin text default 'admin')
returns uuid language plpgsql as $$
declare v uuid;
begin
  perform set_config('request.jwt.claims', json_build_object('sub', tests.id(p_admin), 'role', 'authenticated')::text, true);
  select x into v from public.create_shifts(tests.id(p_org), p_profession::public.profession,
    jsonb_build_array(jsonb_build_object('starts_at', now() + p_offset, 'ends_at', now() + p_offset + p_duration,
                                         'unit', 'Unit ' || p_key, 'slots', p_slots)),
    p_publish) x;
  perform set_config('request.jwt.claims', '', true);
  return tests.remember(p_key, v);
end $$;

-- Keys of the people currently assigned (active) to a shift, in position order.
create function tests.assignees(p_shift text) returns text language sql stable as $$
  select coalesce(string_agg(tests.key(user_id), ',' order by assigned_at, queue_position), '')
  from public.assignments where shift_id = tests.id(p_shift) and status = 'active';
$$;

create function tests.shift_status(p_shift text) returns text language sql stable as $$
  select status::text from public.shifts where id = tests.id(p_shift);
$$;

create function tests.assignment_id(p_shift text, p_who text) returns uuid language sql stable as $$
  select id from public.assignments where shift_id = tests.id(p_shift) and user_id = tests.id(p_who)
  order by assigned_at desc limit 1;
$$;

create function tests.tick(p_queue text default 'qd') returns void language plpgsql as $$
begin
  perform private.process_queue(tests.id(p_queue));
end $$;

-- Move a shift into the past/present (start p_start_ago ago) without tripping checks.
create function tests.shift_started(p_shift text, p_start_ago interval, p_duration interval default interval '12 hours')
returns void language sql as $$
  update public.shifts set starts_at = now() - p_start_ago, ends_at = now() - p_start_ago + p_duration
  where id = tests.id(p_shift);
$$;

-- Position / state / total as seen by the person themselves (my_queue).
create function tests.pos(p_who text, p_org text default 'org') returns int language sql as $$
  select tests.val(p_who, 'select queue_position::text from public.my_queue($1)', tests.id(p_org))::int;
$$;

create function tests.state(p_who text, p_org text default 'org') returns text language sql as $$
  select tests.val(p_who, 'select state from public.my_queue($1)', tests.id(p_org));
$$;

create function tests.total(p_who text, p_org text default 'org') returns int language sql as $$
  select tests.val(p_who, 'select queue_total::text from public.my_queue($1)', tests.id(p_org))::int;
$$;

-- Ordered list of keys currently in the queue (waiting + paused), by position.
create function tests.order_of(p_queue text default 'qd') returns text language sql stable as $$
  select coalesce(string_agg(tests.key(user_id), ',' order by seq), '')
  from public.queue_entries where queue_id = tests.id(p_queue) and closed_at is null and status in ('waiting', 'paused');
$$;

create function tests.audit_count(p_type text, p_subject text default null) returns int language sql stable as $$
  select count(*)::int from public.audit_events
  where type = p_type and (p_subject is null or subject_id = tests.id(p_subject))
    and org_id in (select v from tests.ids where k in ('org', 'org2'));
$$;

create function tests.notif_count(p_who text, p_type text) returns int language sql stable as $$
  select count(*)::int from public.notifications where user_id = tests.id(p_who) and type = p_type;
$$;

grant usage on schema tests to authenticated;
grant select on tests.ids to authenticated;
grant execute on all functions in schema tests to authenticated;
